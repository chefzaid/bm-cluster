# Shared deployment contract.
#
# Keep values shell-safe and unquoted: this file is sourced by Bash and read as
# a Java-properties file by Ansible. Lists are comma-separated and ordered.

PLATFORM_CONTRACT_VERSION=1

DEFAULT_K3S_INSTALL_VERSION=v1.36.3+k3s1
DEFAULT_INGRESS_NGINX_CHART_VERSION=4.15.1
DEFAULT_LONGHORN_CHART_VERSION=1.12.1
DEFAULT_VAULT_CHART_VERSION=0.34.1
DEFAULT_EXTERNAL_SECRETS_CHART_VERSION=2.9.0
DEFAULT_ARGOCD_CHART_VERSION=10.3.3
DEFAULT_ARGOCD_IMAGE_TAG=v3.5.1
DEFAULT_INTERNAL_DNS_ZONE=swirlit.internal
DEFAULT_K3S_REGISTRY_HOST=nexus-registry.swirlit.internal:5000
DEFAULT_K3S_REGISTRY_ENDPOINT=http://10.43.255.250:5000

DEFAULT_LONGHORN_HELM_TIMEOUT=1200s
DEFAULT_LONGHORN_POD_WAIT_TIMEOUT=300s
DEFAULT_INGRESS_HELM_TIMEOUT=300s
DEFAULT_VAULT_WAIT_TIMEOUT=300s
DEFAULT_EXTERNAL_SECRETS_HELM_TIMEOUT=300s
DEFAULT_EXTERNAL_SECRET_WAIT_TIMEOUT=180s
DEFAULT_ARGOCD_HELM_TIMEOUT=600s
DEFAULT_DATASTORE_WAIT_TIMEOUT=300s
DEFAULT_PLATFORM_WAIT_TIMEOUT=900s
DEFAULT_NEXUS_WAIT_TIMEOUT=600s
DEFAULT_POST_DEPLOY_JOB_WAIT_TIMEOUT=420s

FOUNDATION_MANIFESTS=coredns-custom.yaml
DATASTORE_MANIFESTS=postgres.yaml,kafka.yaml,redis.yaml,mongodb.yaml
PLATFORM_MANIFESTS=keycloak.yaml,monitoring.yaml,elk.yaml,logging-agent.yaml,jenkins.yaml,sonarqube.yaml,nexus.yaml,gitlab.yaml,dbgate.yaml,kafka-ui.yaml,portainer.yaml,homepage.yaml,ingress.yaml
POST_DEPLOY_CREATE_MANIFESTS=portainer-bootstrap-job.yaml
EXTERNAL_SECRET_NAMES=postgres-secret,mongodb-secret,odoo-secret,sonarqube-db-credentials,grafana-admin-secret,keycloak-admin-secret,keycloak-realm-config,jenkins-maven-settings,jenkins-npm-config,dbgate-auth-secret,kafka-ui-auth-secret,portainer-auth-secret
DATASTORE_WAIT_APPS=postgres,redis,mongodb,kafka-controller,kafka
PLATFORM_WAIT_APPS=keycloak,jenkins,elasticsearch,kibana,logstash,kube-state-metrics,gitlab,dbgate,kafka-ui,portainer,homepage
PLATFORM_WAIT_DAEMONSETS=node-exporter,fluent-bit

DEFAULT_CLOUDFLARE_ZONE=swirlit.dev
DEFAULT_CLOUDFLARE_HOST_LABELS=argocd,dashboard,dbgate,devapp,gitlab,grafana,jenkins,kafka,keycloak,kibana,longhorn,nexus,odoo,portainer,sonarqube,vault
DEFAULT_CLOUDFLARE_ACCESS_HOST_LABELS=argocd,dashboard,dbgate,grafana,jenkins,kafka,kibana,longhorn,nexus,portainer,sonarqube,vault
EXTERNALLY_MANAGED_HOST_LABELS=devapp

# Private node transport. vRack is OVHcloud-only. Tailscale is the provider-neutral
# choice for hybrid clouds and providers other than OVHcloud.
DEFAULT_K3S_NODE_TRANSPORT=vrack
DEFAULT_TAILSCALE_TAILNET=-
# A tailnet may carry several clusters spanning unrelated providers. Role tags
# are derived as tag:<mesh>-control-plane and tag:<mesh>-worker.
DEFAULT_TAILSCALE_MESH_NAME=bm-cluster
DEFAULT_TAILSCALE_AUTH_KEY_EXPIRY_SECONDS=3600
