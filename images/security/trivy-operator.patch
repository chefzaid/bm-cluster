diff --git a/pkg/policy/policy_data_test.go b/pkg/policy/policy_data_test.go
new file mode 100644
index 0000000..55213cd
--- /dev/null
+++ b/pkg/policy/policy_data_test.go
@@ -0,0 +1,123 @@
+package policy_test
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/aquasecurity/trivy-operator/pkg/policy"
+	"github.com/aquasecurity/trivy/pkg/iac/scan"
+	"github.com/go-logr/logr"
+)
+
+// Exercise the actual embedded registry policy, not a stubbed data loader.
+func TestPolicyDataTrustedRegistry(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "registries.yaml"), []byte("ksv0125:\n  trusted_registries:\n    - registry.example.com\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OPERATOR_POLICY_DATA_DIRS", dir)
+	p := policy.NewPolicies(nil, testConfig{embeddedPolicies: true}, logr.Discard(), nil, "1.36.4", nil)
+	if err := p.Load(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		image string
+		fail  bool
+	}{
+		{"registry.example.com/team/app:1.0", false},
+		{"untrusted.example.net/team/app:1.0", true},
+	} {
+		t.Run(tc.image, func(t *testing.T) {
+			pod := simpleNginxPod.DeepCopy()
+			pod.Name = "registry-policy-test"
+			pod.Namespace = "apps"
+			pod.Spec.Containers[0].Image = tc.image
+			results, err := p.Eval(t.Context(), pod)
+			if err != nil {
+				t.Fatal(err)
+			}
+			seen := false
+			for _, result := range results {
+				if policy.GetResultID(result) != "AVD-KSV-0125" {
+					continue
+				}
+				seen = true
+				if (result.Status() == scan.StatusFailed) != tc.fail {
+					t.Fatalf("registry check failure = %v, want %v", (result.Status() == scan.StatusFailed), tc.fail)
+				}
+			}
+			if !seen {
+				t.Fatal("registry check did not run")
+			}
+		})
+	}
+}
+
+func TestPolicyDataMissingDirectoryFails(t *testing.T) {
+	t.Setenv("OPERATOR_POLICY_DATA_DIRS", filepath.Join(t.TempDir(), "missing"))
+	p := policy.NewPolicies(nil, testConfig{embeddedPolicies: true}, logr.Discard(), nil, "1.36.4", nil)
+	if err := p.InitScanner(); err == nil {
+		t.Fatal("missing policy data must fail initialization")
+	}
+}
+
+func TestPolicyDataChangesReportHash(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("OPERATOR_POLICY_DATA_DIRS", dir)
+	hash := func(registry string) string {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(dir, "registries.yaml"), []byte("ksv0125:\n  trusted_registries:\n    - "+registry+"\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		// Restarting the operator reloads mounted data and invalidates reports.
+		p := policy.NewPolicies(nil, testConfig{embeddedPolicies: true}, logr.Discard(), nil, "1.36.4", nil)
+		value, err := p.Hash("Pod")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return value
+	}
+	first := hash("registry.example.com")
+	if hash("registry.example.com") != first {
+		t.Fatal("unchanged data must retain its hash")
+	}
+	if hash("untrusted.example.net") == first {
+		t.Fatal("changed data must invalidate old reports")
+	}
+}
+
+func TestPolicyDataProjectedConfigMap(t *testing.T) {
+	dir := t.TempDir()
+	version := filepath.Join(dir, "..2026_09_08")
+	if err := os.Mkdir(version, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(version, "registries.yaml"), []byte("ksv0125:\n  trusted_registries:\n    - registry.example.com\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("..2026_09_08", filepath.Join(dir, "..data")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("..data/registries.yaml", filepath.Join(dir, "registries.yaml")); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OPERATOR_POLICY_DATA_DIRS", dir)
+	p := policy.NewPolicies(nil, testConfig{embeddedPolicies: true}, logr.Discard(), nil, "1.36.4", nil)
+	if _, err := p.Hash("Pod"); err != nil {
+		t.Fatal(err)
+	}
+	pod := simpleNginxPod.DeepCopy()
+	pod.Name = "projected-configmap-test"
+	pod.Namespace = "apps"
+	pod.Spec.Containers[0].Image = "registry.example.com/app:1.0"
+	results, err := p.Eval(t.Context(), pod)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, result := range results {
+		if policy.GetResultID(result) == "AVD-KSV-0125" && result.Status() == scan.StatusFailed {
+			t.Fatal("projected ConfigMap allowlist was not loaded")
+		}
+	}
+}
