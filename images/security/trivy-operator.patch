diff --git a/pkg/vulnerabilityreport/severity_regression_test.go b/pkg/vulnerabilityreport/severity_regression_test.go
new file mode 100644
index 0000000..f3c0321
--- /dev/null
+++ b/pkg/vulnerabilityreport/severity_regression_test.go
@@ -0,0 +1,28 @@
+package vulnerabilityreport
+
+import (
+	db "github.com/aquasecurity/trivy-db/pkg/types"
+	ty "github.com/aquasecurity/trivy/pkg/types"
+	"testing"
+)
+
+func TestResolvedSeverityRegression(t *testing.T) {
+	for _, tt := range []struct {
+		name, resolved string
+		vendors        db.VendorSeverity
+		source         db.SourceID
+		want           string
+	}{
+		{name: "resolved scanner rating wins", resolved: "HIGH", vendors: db.VendorSeverity{"nvd": db.SeverityCritical}, want: "HIGH"},
+		{name: "missing source fallback", vendors: db.VendorSeverity{"amazon": db.SeverityHigh}, want: "HIGH"},
+		{name: "selected vendor", vendors: db.VendorSeverity{"debian": db.SeverityLow, "nvd": db.SeverityCritical}, source: "debian", want: "LOW"},
+		{name: "unrated remains unknown", want: "UNKNOWN"},
