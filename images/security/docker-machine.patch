diff --git a/libmachine/mcndockerclient/docker_client_test.go b/libmachine/mcndockerclient/docker_client_test.go
new file mode 100644
index 0000000..ebbdb9e
--- /dev/null
+++ b/libmachine/mcndockerclient/docker_client_test.go
@@ -0,0 +1,95 @@
+package mcndockerclient
+
+import (
+	"crypto/tls"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/docker/machine/libmachine/auth"
+	"github.com/docker/machine/libmachine/cert"
+	"github.com/moby/moby/api/types/container"
+	"github.com/stretchr/testify/require"
+)
+
+type testCertGenerator struct {
+	cert.Generator
+	config *tls.Config
+}
+
+func (g *testCertGenerator) ReadTLSConfig(_ string, _ *auth.Options) (*tls.Config, error) {
+	return g.config, nil
+}
+
+func testHost(t *testing.T, handler http.HandlerFunc) *RemoteDocker {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	cert.SetCertGenerator(&testCertGenerator{Generator: cert.NewX509CertGenerator(), config: server.Client().Transport.(*http.Transport).TLSClientConfig})
+	t.Cleanup(func() { cert.SetCertGenerator(cert.NewX509CertGenerator()) })
+	return &RemoteDocker{HostURL: server.URL, AuthOption: &auth.Options{}}
+}
+
+func TestCreateContainerWithMobyClient(t *testing.T) {
+	for _, pullFails := range []bool{false, true} {
+		t.Run(fmt.Sprint(pullFails), func(t *testing.T) {
+			var actions []string
+			host := testHost(t, func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch {
+				case r.URL.Path == "/_ping":
+					w.Header().Set("API-Version", "1.55")
+					w.WriteHeader(http.StatusOK)
+				case strings.HasSuffix(r.URL.Path, "/images/create"):
+					actions = append(actions, "pull")
+					require.Equal(t, "POST", r.Method)
+					if pullFails {
+						fmt.Fprintln(w, `{"errorDetail":{"message":"test pull denied"},"error":"test pull denied"}`)
+					} else {
+						fmt.Fprintln(w, `{"status":"download complete"}`)
+					}
+				case strings.HasSuffix(r.URL.Path, "/containers/create"):
+					actions = append(actions, "create")
+					require.Equal(t, "smoke", r.URL.Query().Get("name"))
+					var request container.CreateRequest
+					require.NoError(t, json.NewDecoder(r.Body).Decode(&request))
+					require.Equal(t, "busybox:latest", request.Image)
+					w.WriteHeader(http.StatusCreated)
+					fmt.Fprintln(w, `{"Id":"test-container"}`)
+				case strings.HasSuffix(r.URL.Path, "/containers/test-container/start"):
+					actions = append(actions, "start")
+					w.WriteHeader(http.StatusNoContent)
+				default:
+					t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+				}
+			})
+			err := CreateContainer(host, &container.Config{Image: "busybox:latest"}, &container.HostConfig{}, "smoke")
+			if pullFails {
+				require.ErrorContains(t, err, "test pull denied")
+				require.Equal(t, []string{"pull"}, actions)
+			} else {
+				require.NoError(t, err)
+				require.Equal(t, []string{"pull", "create", "start"}, actions)
+			}
+		})
+	}
+}
+
+func TestServerVersionWithMobyClient(t *testing.T) {
+	host := testHost(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.URL.Path == "/_ping" {
+			w.Header().Set("API-Version", "1.55")
+			return
+		}
+		require.True(t, strings.HasSuffix(r.URL.Path, "/version"))
+		fmt.Fprintln(w, `{"Version":"29.5.2","ApiVersion":"1.55"}`)
+	})
+	version, err := (&defaultDockerVersioner{}).DockerVersion(host)
+	require.NoError(t, err)
+	require.Equal(t, "29.5.2", version)
+}
