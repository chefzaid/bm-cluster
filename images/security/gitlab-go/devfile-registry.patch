+package library
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	digest "github.com/opencontainers/go-digest"
+	specs "github.com/opencontainers/image-spec/specs-go"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+func TestSecurityORASRegistryPull(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		allowed   []string
+		want      []string
+		traversal bool
+		tls       bool
+	}{
+		{name: "all", want: []string{"devfile.yaml", "logo.svg"}},
+		{name: "filtered", allowed: []string{DevfileMediaType}, want: []string{"devfile.yaml"}},
+		{name: "unsupported", allowed: []string{"not/a-devfile"}},
+		{name: "tls", want: []string{"devfile.yaml", "logo.svg"}, tls: true},
+		{name: "traversal", traversal: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			payloads := map[digest.Digest][]byte{}
+			descriptor := func(media, name string, data []byte) ocispec.Descriptor {
+				hash := digest.FromBytes(data)
+				payloads[hash] = data
+				d := ocispec.Descriptor{MediaType: media, Digest: hash, Size: int64(len(data))}
+				if name != "" {
+					d.Annotations = map[string]string{ocispec.AnnotationTitle: name}
+				}
+				return d
+			}
+			title := "devfile.yaml"
+			if test.traversal {
+				title = "../escape.yaml"
+			}
+			manifest := ocispec.Manifest{Versioned: specs.Versioned{SchemaVersion: 2}, MediaType: ocispec.MediaTypeImageManifest,
+				Config: descriptor("application/vnd.unknown.config.v1+json", "", []byte("{}")),
+				Layers: []ocispec.Descriptor{descriptor(DevfileMediaType, title, []byte("schemaVersion: 2.3.0\n")), descriptor(DevfileSVGLogoMediaType, "logo.svg", []byte("<svg/>"))}}
+			body, err := json.Marshal(manifest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			root := descriptor(ocispec.MediaTypeImageManifest, "", body)
+			handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if strings.HasPrefix(r.URL.Path, "/v2/") && r.Header.Get("Client") != "security-fixture" {
+					t.Error("registry telemetry header lost")
+				}
+				if r.URL.Path == "/index" {
+					w.Header().Set("Content-Type", "application/json")
+					fmt.Fprint(w, `[{"name":"fixture","links":{"self":"devfile-catalog/fixture:1.0"}}]`)
+					return
+				}
+				if r.URL.Path == "/v2/" {
+					w.WriteHeader(http.StatusOK)
+					return
+				}
+				var data []byte
+				var key digest.Digest
+				media := "application/octet-stream"
+				if strings.Contains(r.URL.Path, "/manifests/") {
+					key = root.Digest
+					data = body
+					media = root.MediaType
+				} else if _, suffix, ok := strings.Cut(r.URL.Path, "/blobs/"); ok {
+					key = digest.Digest(suffix)
+					data = payloads[key]
+				}
+				if data == nil {
+					http.NotFound(w, r)
+					return
+				}
+				w.Header().Set("Content-Type", media)
+				w.Header().Set("Docker-Content-Digest", key.String())
+				w.Header().Set("Content-Length", strconv.Itoa(len(data)))
+				if r.Method != "HEAD" {
+					_, _ = w.Write(data)
+				}
+			})
+			var server *httptest.Server
+			if test.tls {
+				server = httptest.NewTLSServer(handler)
+			} else {
+				server = httptest.NewServer(handler)
+			}
+			defer server.Close()
+			parent := t.TempDir()
+			dest := filepath.Join(parent, "download")
+			options := RegistryOptions{SkipTLSVerify: test.tls, Telemetry: TelemetryData{Client: "security-fixture"}}
+			err = PullStackByMediaTypesFromRegistry(server.URL, "fixture", test.allowed, dest, options)
+			if test.traversal {
+				if err == nil {
+					t.Fatal("path traversal must fail")
+				}
+				if _, err := os.Stat(filepath.Join(parent, "escape.yaml")); !os.IsNotExist(err) {
+					t.Fatal("file escaped download directory")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			files, err := os.ReadDir(dest)
+			if err != nil && !(len(test.want) == 0 && os.IsNotExist(err)) {
+				t.Fatal(err)
+			}
+			if len(files) != len(test.want) {
+				t.Fatalf("downloaded %d files, want %d", len(files), len(test.want))
+			}
+			for _, name := range test.want {
+				data, err := os.ReadFile(filepath.Join(dest, name))
+				if err != nil || len(data) == 0 {
+					t.Fatalf("missing downloaded file %s: %v", name, err)
+				}
+			}
+		})
+	}
+}
