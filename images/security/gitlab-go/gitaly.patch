diff --git a/internal/stream/pktline_test.go b/internal/stream/pktline_test.go
index aaac077..0e9a08f 100644
--- a/internal/stream/pktline_test.go
+++ b/internal/stream/pktline_test.go
@@ -14,11 +14,16 @@ import (
 // buffer.
 type fakeConn struct {
 	io.Reader
-	request bytes.Buffer
+	request     bytes.Buffer
+	requestDone chan struct{}
 }
 
 func (c *fakeConn) Write(p []byte) (int, error) { return c.request.Write(p) }
-func (c *fakeConn) CloseWrite() error           { return nil }
+func (c *fakeConn) CloseWrite() error           { close(c.requestDone); return nil }
+
+// A server response follows the client request. Without this synchronization,
+// the prefilled response can complete before the request goroutine runs.
+func (c *fakeConn) Read(p []byte) (int, error) { <-c.requestDone; return c.Reader.Read(p) }
 
